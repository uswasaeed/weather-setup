library(tidyverse)
library(janitor)
library(lubridate)
#| label: import
weather <- read_rds("data-processed/01-weather-cleaned.rds")
weather |> glimpse()
weather |>
select(date, prcp) |>
arrange(desc(prcp)) |>
filter(prcp >= 5)
weather |>
select(date, tmax) |>
arrange(desc(tmax)) |>
head(10)
weather |>
select(date, tmin) |>
arrange(tmin) |>
head(10)
weather |>
filter(tmax >= 100) |>
group_by(year = year(date)) |>
summarize(days_100_plus = n()) |>
arrange(desc(days_100_plus)) |>
filter(days_100_plus >= 50)
weather |>
group_by(year = year(date)) |>
summarize(total_rain = sum(prcp, na.rm = TRUE)) |>
arrange(desc(total_rain))
weather |>
group_by(year = year(date)) |>
summarize(total_rain = sum(prcp, na.rm = TRUE)) |>
arrange(total_rain) |>
head(10)
weather |>
group_by(year = year(date)) |>
summarize(total_snow = sum(snow, na.rm = TRUE)) |>
arrange(desc(total_snow))
weather |>
group_by(year = year(date)) |>
summarize(
avg_high_temp = mean(tmax, na.rm = TRUE),
avg_low_temp = mean(tmin, na.rm = TRUE)
) |>
arrange(desc(avg_high_temp))
rain_month_year <- weather |>
filter(year(date) >= 1990) |>
group_by(year = year(date), month = month(date, label = TRUE)) |>
summarize(total_rain = sum(prcp, na.rm = TRUE))
rain_month_year |>
ungroup() |>
group_by(month) |>
summarize(avg_monthly_rain = mean(total_rain, na.rm = TRUE)) |>
arrange(desc(avg_monthly_rain))
weather |>
group_by(year = year(date)) |>
summarize(
avg_high_temp = mean(tmax, na.rm = TRUE),
avg_low_temp = mean(tmin, na.rm = TRUE)
) |>
mutate(avg_year_temp = (avg_high_temp + avg_low_temp) / 2) |>
arrange(desc(avg_year_temp))
weather |>
filter(tmax >= 100) |>
group_by(year = year(date)) |>
arrange(date) |>
slice_min(date, n = 1) |>
select(year, date, tmax) |>
ungroup() |>
arrange(date)
weather |>
filter(tmax >= 100) |>
mutate(
day_of_year = yday(date),
year = year(date)
) |>
slice_min(day_of_year, n = 1) |>
select(year, date, tmax)
weather |>
filter(tmin <= 32, month(date) < 7, year(date) < 2026) |>
mutate(year = year(date)) |>
slice_max(date, n = 1) |>
select(year, date, tmin)
hot_days_by_year <- weather |>
filter(tmax >= 100) |>
group_by(year = year(date)) |>
summarize(days_100_plus = n()) |>
arrange(desc(days_100_plus))
hot_days_by_year |>
ggplot(aes(x = reorder(year, days_100_plus), y = days_100_plus)) +
geom_col() +
coord_flip() +
labs(
title = "Years with the Most 100+ Degree Days in Austin",
subtitle = "Each bar shows total days per year with temperatures at or above 100 degrees",
x = "Year",
y = "Number of 100+ Degree Days"
)
hot_days_by_year <- weather |>
filter(tmax >= 100) |>
group_by(year = year(date)) |>
summarize(days_100_plus = n()) |>
arrange(desc(days_100_plus)) |>
filter(days_100_plus >= 50)
hot_days_by_year |>
ggplot(aes(x = reorder(year, days_100_plus), y = days_100_plus)) +
geom_col() +
coord_flip() +
labs(
title = "Years with 50+ Days Over 100 Degrees in Austin",
subtitle = "Only years with at least 50 extreme heat days are shown",
x = "Year",
y = "Number of 100+ Degree Days"
)
rain_month_year <- weather |>
filter(year(date) >= 1990) |>
group_by(year = year(date), month = month(date, label = TRUE)) |>
summarize(total_rain = sum(prcp, na.rm = TRUE), .groups = "drop")
avg_monthly_rain <- rain_month_year |>
group_by(month) |>
summarize(avg_monthly_rain = mean(total_rain, na.rm = TRUE)) |>
arrange(desc(avg_monthly_rain))
avg_monthly_rain |>
ggplot(aes(x = month, y = avg_monthly_rain)) +
geom_col() +
labs(
title = "Average Monthly Rainfall in Austin Since 1990",
subtitle = "Monthly averages based on total rainfall per year",
x = "Month",
y = "Average Rainfall (inches)"
)
yearly_temps <- weather |>
group_by(year = year(date)) |>
summarize(
avg_high_temp = mean(tmax, na.rm = TRUE),
avg_low_temp = mean(tmin, na.rm = TRUE)
) |>
filter(year != 1938, year != 2026)
yearly_temps_long <- yearly_temps |>
pivot_longer(
cols = c(avg_high_temp, avg_low_temp),
names_to = "type",
values_to = "temperature"
)
yearly_temps_long |>
ggplot(aes(x = year, y = temperature, color = type)) +
geom_line() +
labs(
title = "Average Yearly High and Low Temperatures in Austin",
subtitle = "Excluding partial years",
x = "Year",
y = "Temperature (°F)"
)
