library(tidyverse)
library(janitor)
#| label: import
weather <- read_csv("data-original/weather.csv")
weather |> glimpse()
weather_clean <- weather |>
clean_names() |>
select(!c(tavg, tobs))
weather_clean |> glimpse()
#| label: export
write_rds(
weather_clean,
"data-processed/01-weather-cleaned.rds"
)
