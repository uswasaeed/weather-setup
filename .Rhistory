library(tidyverse)
library(janitor)
#| label: import
weather <- read_rds("data-processed/01-weather-cleaned.rds")
weather |> glimpse()
weather |>
select(date, prcp) |>
arrange(desc(prcp)) |>
filter(prcp >= 5)
weather |>
select(date, tmax) |>
arrange(desc(tmax)) |>
head(10)
weather |>
select(date, tmin) |>
arrange(tmin) |>
head(10)
weather |>
filter(tmax >= 100) |>
group_by(year = year(date)) |>
summarize(days_100_plus = n()) |>
arrange(desc(days_100_plus)) |>
filter(days_100_plus >= 50)
weather |>
group_by(year = year(date)) |>
summarize(total_rain = sum(prcp, na.rm = TRUE)) |>
arrange(desc(total_rain))
weather |>
group_by(year = year(date)) |>
summarize(total_rain = sum(prcp, na.rm = TRUE)) |>
arrange(total_rain) |>
head(10)
weather |>
group_by(year = year(date)) |>
summarize(total_snow = sum(snow, na.rm = TRUE)) |>
arrange(desc(total_snow))
weather |>
group_by(year = year(date)) |>
summarize(total_rain = sum(prcp, na.rm = TRUE)) |>
arrange(total_rain) |>
head(10)
weather |>
group_by(year = year(date)) |>
summarize(
avg_high_temp = mean(tmax, na.rm = TRUE),
avg_low_temp = mean(tmin, na.rm = TRUE)
) |>
arrange(desc(avg_high_temp))
rain_month_year <- weather |>
filter(year(date) >= 1990) |>
group_by(year = year(date), month = month(date, label = TRUE)) |>
summarize(total_rain = sum(prcp, na.rm = TRUE))
rain_month_year <- weather |>
filter(year(date) >= 1990) |>
group_by(year = year(date), month = month(date, label = TRUE)) |>
summarize(total_rain = sum(prcp, na.rm = TRUE))
rain_month_year |>
ungroup() |>
group_by(month) |>
summarize(avg_monthly_rain = mean(total_rain, na.rm = TRUE)) |>
arrange(desc(avg_monthly_rain))
weather |>
group_by(year = year(date)) |>
summarize(
avg_high_temp = mean(tmax, na.rm = TRUE),
avg_low_temp = mean(tmin, na.rm = TRUE)
) |>
mutate(avg_year_temp = (avg_high_temp + avg_low_temp) / 2) |>
arrange(desc(avg_year_temp))
weather |>
filter(tmax >= 100) |>
group_by(year = year(date)) |>
arrange(date) |>
slice_min(date, n = 1) |>
ungroup() |>
arrange(date)
weather |>
filter(tmin <= 32, month(date) < 7) |>
group_by(year = year(date)) |>
arrange(desc(date)) |>
slice_max(date, n = 1) |>
ungroup() |>
arrange(desc(date))
rain_month_year <- weather |>
filter(year(date) >= 1990) |>
group_by(year = year(date), month = month(date, label = TRUE)) |>
summarize(total_rain = sum(prcp, na.rm = TRUE))
rain_month_year |>
ungroup() |>
group_by(month) |>
summarize(avg_monthly_rain = mean(total_rain, na.rm = TRUE)) |>
arrange(desc(avg_monthly_rain))
weather |>
filter(tmax >= 100) |>
group_by(year = year(date)) |>
arrange(date) |>
slice_min(date, n = 1) |>
select(year, date, tmax) |>
ungroup() |>
arrange(date)
weather |>
filter(tmax >= 100) |>
mutate(day_of_year = yday(date)) |>
slice_min(day_of_year, n = 1) |>
select(year = year(date), date, tmax, day_of_year)
